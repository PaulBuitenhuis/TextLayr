{
  "schema": 1,
  "id": "builtin:highlight-pill",
  "name": "Highlight Pill",
  "description": "White words with the active word set in dark type on a yellow plate.",
  "style": {
    "font": {
      "family": "Inter",
      "size_pct": 4.0,
      "active_bold": true,
      "dim_bold": true,
      "uppercase": false,
      "letter_spacing": 0.0
    },
    "text": {
      "highlight": {
        "r": 20,
        "g": 18,
        "b": 12,
        "a": 255
      },
      "dim": {
        "r": 245,
        "g": 245,
        "b": 245,
        "a": 255
      },
      "opacity": 1.0,
      "outline": {
        "enabled": false,
        "color": {
          "r": 0,
          "g": 0,
          "b": 0,
          "a": 255
        },
        "width": 0.08
      },
      "shadow": {
        "enabled": false,
        "color": {
          "r": 0,
          "g": 0,
          "b": 0,
          "a": 160
        },
        "offset_x": 0.03,
        "offset_y": 0.04,
        "blur": 0.04
      },
      "glow": {
        "enabled": false,
        "color": {
          "r": 255,
          "g": 214,
          "b": 102,
          "a": 180
        },
        "radius": 0.1
      }
    },
    "box": {
      "color": {
        "r": 0,
        "g": 0,
        "b": 0,
        "a": 255
      },
      "opacity": 0.0,
      "rounded": true,
      "radius_frac": 0.18,
      "padding_x": 0.5,
      "padding_y": 0.24,
      "border_width": 0.0,
      "border_color": {
        "r": 255,
        "g": 255,
        "b": 255,
        "a": 255
      },
      "shadow": false,
      "shadow_color": {
        "r": 0,
        "g": 0,
        "b": 0,
        "a": 255
      },
      "shadow_opacity": 1.0,
      "shadow_offset_y": 0.1,
      "shadow_blur": 0.14
    },
    "layout": {
      "position_pct": 72.0
    },
    "highlight": {
      "scale": 1.04,
      "pill": {
        "enabled": true,
        "color": {
          "r": 255,
          "g": 205,
          "b": 76,
          "a": 255
        },
        "padding_x": 0.14,
        "padding_y": 0.05,
        "radius_frac": 0.35
      },
      "underline": {
        "enabled": false,
        "color": {
          "r": 255,
          "g": 255,
          "b": 255,
          "a": 255
        },
        "width": 0.05,
        "offset": 0.02
      }
    },
    "motion": {
      "popup": "pop",
      "exit": "pop",
      "duration_ms": 200,
      "exit_duration_ms": 140,
      "easing": "ease_out",
      "intensity": 0.16
    }
  },
  "grouping": {
    "words_per_popup": 3
  }
}
