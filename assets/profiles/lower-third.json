{
  "schema": 1,
  "id": "builtin:lower-third",
  "name": "Lower Third",
  "description": "Smaller documentary-style text low in the frame, six words at a time.",
  "style": {
    "font": {
      "family": "Inter",
      "size_pct": 2.9
    },
    "text": {
      "highlight": {
        "r": 255,
        "g": 209,
        "b": 102,
        "a": 255
      },
      "dim": {
        "r": 235,
        "g": 235,
        "b": 235,
        "a": 255
      }
    },
    "box": {
      "color": {
        "r": 0,
        "g": 0,
        "b": 0,
        "a": 255
      },
      "opacity": 0.65,
      "rounded": false,
