#!/bin/sh
# Harness fixture: delegate to the real ffprobe. See ./ffmpeg.
if [ -n "${TEXTLAYR_FFTOOLS_LOG:-}" ]; then
    printf 'ffprobe %s\n' "$*" >> "$TEXTLAYR_FFTOOLS_LOG"
fi
if [ -n "${TEXTLAYR_REAL_FFPROBE:-}" ]; then
    exec "$TEXTLAYR_REAL_FFPROBE" "$@"
fi
real=$(command -v ffprobe) || {
    echo "textlayr-fixture: no real ffprobe on PATH" >&2
    exit 127
}
exec "$real" "$@"
