#!/bin/sh
# Harness fixture: the decoder succeeds, then the encoder fails to start.
# Proves the decoder is killed and reaped instead of being left running.
case " $* " in
    # The one-frame size probe is not a long-lived child; don't log it.
    *" -frames:v 1 "*) ;;
    *" -i pipe:0 "*)
        echo "textlayr-fixture: the encoder failed to start" >&2
        exit 4
        ;;
    *)
        # Only the decoder is logged: it is the process that leaked before the
        # child guard was added.
        if [ -n "${TEXTLAYR_FFTOOLS_PIDS:-}" ]; then
            printf '%s\n' "$$" >> "$TEXTLAYR_FFTOOLS_PIDS"
        fi
        ;;
esac
if [ -n "${TEXTLAYR_REAL_FFMPEG:-}" ]; then
    exec "$TEXTLAYR_REAL_FFMPEG" "$@"
fi
real=$(command -v ffmpeg) || {
    echo "textlayr-fixture: no real ffmpeg on PATH" >&2
    exit 127
}
exec "$real" "$@"
